# Copy this file to `.env` and fill in the keys you need.
# `.env` is git-ignored. These are only required for the remote providers
# (gaps / critique / diagram / mindmap, or an escalated ask). docmind runs
# fully local without them. Exported shell vars override anything set here.

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# Kimi K3 (Moonshot)
KIMI_API_KEY=

# --- Optional settings overrides -------------------------------------------
# Any config key can be overridden here with DOCMIND_<KEY> (takes precedence
# over docmind/data/config.json). Handy for pinning models in one place.
# DOCMIND_REMOTE_PROVIDER=claude          # claude | kimi
# DOCMIND_CLAUDE_MODEL=claude-opus-4-8    # escalated ask
# DOCMIND_CLAUDE_HEAVY_MODEL=claude-opus-4-8   # gaps / critique
# DOCMIND_KIMI_MODEL=kimi-k3-turbo-preview
# DOCMIND_LOCAL_CHAT_MODEL=qwen3:14b
# DOCMIND_TOP_K=8
# DOCMIND_BUDGET_CAP=5.0

# Optional: relocate docmind's local data directory
# DOCMIND_DATA=
